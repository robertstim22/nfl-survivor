{
  "name": "nfl-survivor-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute nfl-survivor --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute nfl-survivor --local --file=schema.sql",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "4.164.0"
  }
}
